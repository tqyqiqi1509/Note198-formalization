#!/usr/bin/env bash
set -eu
source /opt/codex-comparator/env.sh
if [ "$#" -ne 1 ]; then
  echo 'Usage: comparator-check /path/to/project/config.json'; exit 2
fi
config=$(realpath "$1")
project="$PWD"
case "$project" in /mnt/*) echo 'Run from a project on the Linux filesystem, under /opt/codex-comparator/workspaces.' >&2; exit 2;; esac
if [ "$(id -u)" -eq 0 ]; then echo 'Run as a regular user.' >&2; exit 2; fi
version=$(cat lean-toolchain)
if [ "$version" != 'leanprover/lean4:v4.34.1' ]; then echo 'This installation targets Lean 4.34.1; use a matching comparator/exporter for other toolchains.' >&2; exit 2; fi
exec systemd-run --user --wait --pipe --collect  --property=RestrictAddressFamilies=~AF_UNIX  --property=MemoryMax=5G --property=CPUQuota=200%  --working-directory="$project"  --setenv="PATH=$PATH" --setenv="ELAN_HOME=$ELAN_HOME"  --setenv="LEAN_NUM_THREADS=1" --setenv="MIMALLOC_ARENA_EAGER_COMMIT=0"  --setenv="COMPARATOR_LANDRUN=$COMPARATOR_LANDRUN"  --setenv="COMPARATOR_LEAN4EXPORT=$COMPARATOR_LEAN4EXPORT"  /opt/codex-comparator/elan/bin/lake env  /opt/codex-comparator/source/.lake/build/bin/comparator "$config"
